<UserControl x:Class="Uniconverter.Gui.Views.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Uniconverter.Gui.Views"
             xmlns:nav="clr-namespace:Uniconverter.Gui"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="800">
    <StackPanel
                 Orientation="Horizontal"
                 VerticalAlignment="Top"
                 Background="LightGreen"
                 Margin="4">
        <RadioButton
                    Style="{StaticResource MaterialDesignTabRadioButton}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.Home}"
                    IsChecked="True"
                    Margin="4"
                    Content="Home" />
        <RadioButton
                    Style="{StaticResource MaterialDesignTabRadioButton}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.CompareView}"
                    Margin="4"
                    Content="Compare Files" />
        <RadioButton
                    Style="{StaticResource MaterialDesignTabRadioButton}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.ProjectManagment}"
                    Margin="4"
                    IsChecked="False"
                    Content="Fixture Managment" />
    </StackPanel>
</UserControl>
