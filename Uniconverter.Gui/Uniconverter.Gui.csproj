<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Images\Logo\UniConverter.ico</ApplicationIcon>
    <Win32Resource />
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\Logo\ProMik.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="3.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="3.1.2" />
    <PackageReference Include="PropertyChanged2.Fody" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\Logo\ProMik.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Images\Symbols\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uniconverter.Core\Uniconverter.Core.csproj" />
  </ItemGroup>

</Project>