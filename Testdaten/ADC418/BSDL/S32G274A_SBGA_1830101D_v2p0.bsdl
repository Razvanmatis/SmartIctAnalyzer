   attribute AIO_COMPONENT_CONFORMANCE of S32G274A : entity is "STD_1149_6_2003";

   attribute AIO_PIN_BEHAVIOR of S32G274A : entity is

     "PCIE0_RX0_P : LP_time=22.5e-9 HP_time=45.0e-9; " &
     "PCIE0_RX1_P : LP_time=22.5e-9 HP_time=45.0e-9; " &
     "PCIE1_RX0_P : LP_time=22.5e-9 HP_time=45.0e-9; " &
     "PCIE1_RX1_P : LP_time=22.5e-9 HP_time=45.0e-9; " &
     "PCIE0_TX0_P;" &
     "PCIE0_TX1_P;" &
     "PCIE1_TX0_P;" &
     "PCIE1_TX1_P" ;

  attribute DESIGN_WARNING of S32G274A : entity is
    
    "WARNING: The PCIE0 and PCIE1 RX/TX pins and associated BSR cells will not     "&
    "perform EXTEST_TRAIN or EXTEST_PULSE instructions unless the ENABLE_DATA1     "&
    "opcode has set the JTAG_DATA1[2]=1 to enable PCIE1 BSR and JTAG_DATA1[1]=1    "&
    "to enable PCIE0 BSR for 1149.6 operations. All other JTAG_DATA1 bit should    "&
    "set to 0.                                                                     "&
    "                                                                              "&
    "WARNING: The PCIE0_CLK_N/PCIE0_CLK_P and PCIE1_CLK_N/PCIE1_CLK_P differential "&
    "pin pairs do not have either 1149.1 or 1149.6 BSR cells defined and cannot be "&
    "tested by JTAG.                                                               "&
    "                                                                              "&
    "WARNING: RESET_B does not have BSR cells and cannot be tested by JTAG.        "&
     "                                                                             "&
    "WARNING: AUR_TXn_N/_P and AUR_CLK_N/_P do not have BSR cells and cannot be    "&
    "tested by JTAG.                                                               "&
    "                                                                              "&
    "WARNING: A functional Power-On Reset sequence is required before issuing      "&
    "BSR instructions.                                                             "&
    "                                                                              "&
    "WARNING: DDR0_D_nn pins cannot SAMPLE the input pins during mission mode as   "&
    "The path to the BSR is blocked. PRELOAD is not affected.                      ";

 end S32G274A;
