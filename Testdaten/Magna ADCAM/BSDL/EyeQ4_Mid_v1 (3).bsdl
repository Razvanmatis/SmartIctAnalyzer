        "uart_a_rx            : AD21," &
        "uart_a_tx            : AC21," &
        "uart_b_rx            : AC22," &
        "uart_b_tx            : AC23," &
        "xint                 : U7," &
        "ddr0_ca_a            : (D21, A26, A22, B21, B25, A24)," &
        "ddr0_ca_b            : (E26, D25, C26, D27, C28, B27)," &
        "ddr0_dmi_a           : (D19, D16)," &
        "ddr0_dmi_b           : (H25, L25)," &
        "ddr0_dq_a            : (A20, C20, D20, E20, D18, E18, C18, A18, A15, C15, E15, D15, D17, E17, C17, A17)," &
        "ddr0_dq_b            : (G28, G26, G25, G24, J25, J24, J26, J28, M26, M28, M24, M25, K25, K24, K28, K26)," &
        "ddr0_dqs_c_a         : (B19, B16)," &
        "ddr0_dqs_c_b         : (H27, L27)," &
        "ddr0_dqs_t_a         : (A19, A16)," &
        "ddr0_dqs_t_b         : (H28, L28)," &
        "ddr0_dto             : (F21, F22)," &
        "gpio_ra              : (AD19, AE19, AC20, AA19, AD20, AA20, AE21, AB20, AE20)," &
        "gpio_ra_0            : AB19," &
        "mipi_rx_4l_dn_cl     : (AH5, AH11)," &
        "mipi_rx_4l_dn_dl0    : (AH4, AH10)," &
        "mipi_rx_4l_dn_dl1    : (AH6, AH12)," &
        "mipi_rx_4l_dn_dl2    : (AH7, AH13)," &
        "mipi_rx_4l_dn_dl3    : (AH3, AH9)," &
        "mipi_rx_4l_dp_cl     : (AG5, AG11)," &
        "mipi_rx_4l_dp_dl0    : (AG4, AG10)," &
