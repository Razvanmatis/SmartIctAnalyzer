 entity EyeQ4_Top is
   
-- This section identifies the default device package selected.
   
   generic (PHYSICAL_PIN_MAP: string:= "EyeQ4_Top");
   
-- This section declares all the ports in the design.
   
   port ( 
          ntrst_n              : in       bit;
          por_n                : in       bit;
          ref_clk              : in       bit;
          tck                  : in       bit;
          tdi                  : in       bit;
          tms                  : in       bit;
          can_a_rx             : inout    bit;
          can_a_tx             : inout    bit;
          can_b_rx             : inout    bit;
          can_b_tx             : inout    bit;
          ddr0_ck_c_a          : inout    bit;
          ddr0_ck_c_b          : inout    bit;
          ddr0_ck_t_a          : inout    bit;
          ddr0_ck_t_b          : inout    bit;
          ddr0_cke_a           : inout    bit;
          ddr0_cke_b           : inout    bit;
          ddr0_cs_a            : inout    bit;
          ddr0_cs_b            : inout    bit;
          ddr0_odt_ca          : inout    bit;
          ddr0_reset_n         : inout    bit;
          errout               : inout    bit;
          i2c_a_scl            : inout    bit;
          i2c_a_sda            : inout    bit;
          i2c_b_scl            : inout    bit;
          i2c_b_sda            : inout    bit;
          pdt_probe_n          : inout    bit;
          pdt_trigin           : inout    bit;
          pvia_hsync           : inout    bit;
          pvia_pclk            : inout    bit;
          pvia_vsync           : inout    bit;
          rgmii_rx_clk         : inout    bit;
          rgmii_rx_ctl         : inout    bit;
          rgmii_tx_clk         : inout    bit;
          rgmii_tx_ctl         : inout    bit;
          rst_n                : inout    bit;
          sfi_ck               : inout    bit;
          sma_mdc              : inout    bit;
          sma_mdio             : inout    bit;
          spi_a_ck             : inout    bit;
          spi_a_cs0            : inout    bit;
          spi_a_cs1            : inout    bit;
          spi_a_di             : inout    bit;
          spi_a_do             : inout    bit;
          spi_b_ck             : inout    bit;
          spi_b_cs0            : inout    bit;
          spi_b_cs1            : inout    bit;
          spi_b_di             : inout    bit;
          spi_b_do             : inout    bit;
          uart_a_rx            : inout    bit;
          uart_a_tx            : inout    bit;
          uart_b_rx            : inout    bit;
          uart_b_tx            : inout    bit;
          xint                 : inout    bit;
          ddr0_ca_a            : inout    bit_vector (0 to 5);
          ddr0_ca_b            : inout    bit_vector (0 to 5);
          ddr0_dmi_a           : inout    bit_vector (0 to 1);
          ddr0_dmi_b           : inout    bit_vector (0 to 1);
          ddr0_dq_a            : inout    bit_vector (0 to 15);
          ddr0_dq_b            : inout    bit_vector (0 to 15);
          ddr0_dqs_c_a         : inout    bit_vector (0 to 1);
          ddr0_dqs_c_b         : inout    bit_vector (0 to 1);
          ddr0_dqs_t_a         : inout    bit_vector (0 to 1);
          ddr0_dqs_t_b         : inout    bit_vector (0 to 1);
          ddr0_dto             : inout    bit_vector (0 to 1);
          gpio_ra              : inout    bit_vector (1 to 9);
          gpio_ra_0            : in       bit;
          mipi_rx_4l_dn_cl     : inout    bit_vector (0 to 1);
          mipi_rx_4l_dn_dl0    : inout    bit_vector (0 to 1);
          mipi_rx_4l_dn_dl1    : inout    bit_vector (0 to 1);
          mipi_rx_4l_dn_dl2    : inout    bit_vector (0 to 1);
          mipi_rx_4l_dn_dl3    : inout    bit_vector (0 to 1);
          mipi_rx_4l_dp_cl     : inout    bit_vector (0 to 1);
          mipi_rx_4l_dp_dl0    : inout    bit_vector (0 to 1);
          mipi_rx_4l_dp_dl1    : inout    bit_vector (0 to 1);
          mipi_rx_4l_dp_dl2    : inout    bit_vector (0 to 1);
          mipi_rx_4l_dp_dl3    : inout    bit_vector (0 to 1);
          pvia_d               : inout    bit_vector (0 to 15);
          rgmii_rd             : inout    bit_vector (0 to 3);
          rgmii_td             : inout    bit_vector (0 to 3);
          sfi_cs_n             : inout    bit_vector (0 to 2);
          sfi_d                : inout    bit_vector (0 to 3);
          tdo                  : out      bit;
          clk_in               : linkage  bit;
          clk_out              : linkage  bit;
          ddr0_ato             : linkage  bit;
          ddr0_pzq             : linkage  bit;
          testen               : in       bit
   );
   
   use STD_1149_1_2001.all;
   
   attribute COMPONENT_CONFORMANCE of EyeQ4_Top: entity is "STD_1149_1_2001";
   
   attribute PIN_MAP of EyeQ4_Top: entity is PHYSICAL_PIN_MAP;
   
-- This section specifies the pin map for each port. This information is extracted from the 
-- port-to-pin map file that was read in using the "read_pin_map" command.
   
     constant EyeQ4_Top: PIN_MAP_STRING := 
        "ntrst_n              : T4," &
        "por_n                : U4," &
        "ref_clk              : AB24," &
        "tck                  : V6," &
        "tdi                  : U5," &
        "tms                  : U6," &
        "can_a_rx             : AD22," &
        "can_a_tx             : AE22," &
        "can_b_rx             : AD23," &
        "can_b_tx             : AE23," &
        "ddr0_ck_c_a          : A23," &
        "ddr0_ck_c_b          : E28," &
        "ddr0_ck_t_a          : B23," &
        "ddr0_ck_t_b          : E27," &
        "ddr0_cke_a           : C24," &
        "ddr0_cke_b           : E24," &
        "ddr0_cs_a            : E22," &
