// SVF test file to set the LEDs on ZedBoard
// uses scanned out 'safe' settings for the non-LED IOs
//
// set JTAG clock to 10 MHz
FREQUENCY 10E6 HZ;
// set JTAG TAP to IDLE state
STATE IDLE;
// set end state for IR and DR shifts
ENDIR IDLE;
ENDDR IDLE;
// IR shift with PRELOAD (0x01) or EXTEST (0x26) instr.
SIR 6 TDI (01);
// DR shift with target specific scan-length
SDR 1077 TDI (0001FFFFF3FFFFFFFDBFFE79E4F27FFFFF7FFFFFE9249FF8B6DB6FB6DB2DB6DBEDB64924924930D2492492492DB6DBEDB6CB6DB6FB6DFFFFFFFFFFFFFFFFFFFFBFFFFFFFFFFFFFFFFC00000FFFFFFFFFFFFFFFFFFFFFFFFFFFDFFFFFDBEFFFFFFF
FFFFFFFFFFFFFFFFFFFFFF7FFFFF6DBE402487FFFFFFFFFFF7FF7FFFFFFFFFFFFFFFE0000BF6) 
// 200ms delay in IDLE state, remain in IDLE state
RUNTEST 0.2 SEC ENDSTATE IDLE;
