<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ui</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <NeutralLanguage>en-150</NeutralLanguage>
	<IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="LaTex\build.bat" />
    <None Remove="LaTex\images\ProMik-Logo_4C-eps-converted-to.pdf" />
    <None Remove="LaTex\images\ProMik-Logo_4C.eps" />
    <None Remove="LaTex\images\ProMik_R.pdf" />
    <None Remove="LaTex\Style.tex" />
    <None Remove="LaTex\testCoverage.pdf" />
    <None Remove="LaTex\testCoverage.tex" />
    <None Remove="LaTex\TestCoverageData.tex" />
    <None Remove="Ressources\start.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.1.0" />
    <PackageReference Include="log4net" Version="2.0.12" />
    <PackageReference Include="MaterialDesignThemes" Version="4.1.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="3.1.0" />
    <PackageReference Include="Prism.DryIoc" Version="8.0.0.1909" />
    <PackageReference Include="ProMik.BSDL.Interfaces" Version="1.0.16-beta" />
    <PackageReference Include="ProMik.BSDL.Processor" Version="1.0.16-beta" />
    <PackageReference Include="ProMik.BSDLPackageAnalyzer" Version="1.0.16-beta" />
    <PackageReference Include="ProMik.Core" Version="1.0.71-beta" />
    <PackageReference Include="ProMik.Core.Interfaces" Version="1.0.71-beta" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ui.Core\Ui.Core.csproj" />
    <ProjectReference Include="..\Modules\Ui.Modules.ModuleName\Ui.Modules.ModuleName.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
    <AdditionalFiles Include="..\..\stylecop.json" Link="Properties\stylecop.json" />
    <EmbeddedResource Include="LaTex\build.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="LaTex\images\ProMik-Logo_4C-eps-converted-to.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="LaTex\images\ProMik-Logo_4C.eps">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="LaTex\images\ProMik_R.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="LaTex\Style.tex">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="LaTex\testCoverage.tex">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="LaTex\TestCoverageData.tex">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <Resource Include="Ressources\start.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <PackageReference Include="Microsoft.CodeAnalysis.FxCopAnalyzers" Version="3.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>