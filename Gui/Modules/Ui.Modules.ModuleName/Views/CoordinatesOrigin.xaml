<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:if="clr-namespace:Ui.Modules.ModuleName.ViewModels">
    <DataTemplate DataType="{x:Type if:CoordinatesOriginViewModel}">
        <Grid>
            <Grid.ToolTip>
                <ToolTip Content="Origin of the coordinate system" Placement="MousePoint"/>
            </Grid.ToolTip>
            <Grid.RenderTransform>
                <TranslateTransform X="{Binding PosXWithOffset}" Y="{Binding PosYWithOffset}"/>
            </Grid.RenderTransform>
            <Label Content="X" FontWeight="Bold" FontSize="25" Background="Transparent" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>