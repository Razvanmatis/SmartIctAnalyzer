<UserControl x:Class="Ui.Modules.ModuleName.Views.ComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ui.Modules.ModuleName.ViewModels"
             xmlns:helper="clr-namespace:Ui.Modules.ModuleName.Helper"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             prism:ViewModelLocator.AutoWireViewModel="true" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="2" Grid.RowSpan="2" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      helper:DropFilesBehaviorExtension.IsEnabled="True"
                      helper:ScrollViewerAttached.ScrollViewerProperty="{Binding SetScrollViewerCommand}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseWheel">
                    <i:InvokeCommandAction Command="{Binding MouseWheelCommand}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding MouseMoveStart}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove">
                    <i:InvokeCommandAction Command="{Binding MouseMove}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <i:InvokeCommandAction Command="{Binding MouseMoveEnd}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
                <i:EventTrigger EventName="MouseLeave">
                    <i:InvokeCommandAction Command="{Binding MouseLeave}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <vm:CanvasItemsControl ItemsSource="{Binding Path=ComponentViews}">
                <ItemsControl.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="PCBComponentBaseDataTemplate.xaml"/>
                            <ResourceDictionary Source="PCBLineDataTemplate.xaml"/>
                            <ResourceDictionary Source="PCBTestpointDataTemplate.xaml"/>
                            <ResourceDictionary Source="CoordinatesOrigin.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="{Binding OverallWidth, UpdateSourceTrigger=PropertyChanged}"
                                Height="{Binding OverallHeight, UpdateSourceTrigger=PropertyChanged}">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding ZoomFactor, UpdateSourceTrigger=PropertyChanged}"
                                        ScaleY="{Binding ZoomFactor, UpdateSourceTrigger=PropertyChanged}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </vm:CanvasItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Run Text="X:" />
            <Run Text="{Binding XPosition, StringFormat={}{0:#,0.00}, UpdateSourceTrigger=PropertyChanged}" />
            <Run Text="Y:" />
            <Run Text="{Binding YPosition, StringFormat={}{0:#,0.00}, UpdateSourceTrigger=PropertyChanged}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="5" Visibility="{Binding ButtonVisibility}">
            <Button VerticalAlignment="Center" Command="{Binding ButtonScrollInCommand}" FontSize="30" FontWeight="Bold" Height="50" Width="50" Margin="5">
                <Button.Content>
                    <materialDesign:PackIcon Kind="Plus" Width="22" Height="22"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button.Content>
            </Button>
            <Button VerticalAlignment="Center" FontSize="30" Command="{Binding ButtonScrollOutCommand}" FontWeight="Bold" Height="50" Width="50" Margin="5">
                <Button.Content>
                    <materialDesign:PackIcon Kind="Minus" Width="22" Height="22"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button.Content>
            </Button>
            <Button VerticalAlignment="Center" FontSize="30" Command="{Binding MirrorCommand}" CommandParameter="True" FontWeight="Bold" Height="50" Width="50" Margin="5">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ViewDayOutline" Width="22" Height="22"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button.Content>
            </Button>
            <Button VerticalAlignment="Center" FontSize="30" Command="{Binding MirrorCommand}" CommandParameter="False" FontWeight="Bold" Height="50" Width="50" Margin="5">
                <Button.Content>
                    <materialDesign:PackIcon Kind="ViewArrayOutline" Width="22" Height="22"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
