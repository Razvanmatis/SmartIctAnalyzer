<Window x:Class="Ui.Modules.ModuleName.Views.TestCoverageSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ui.Modules.ModuleName.Views"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="true"
        mc:Ignorable="d"
        Title="Test coverage settings" Height="200" Width="800">
    <Window.InputBindings>
        <KeyBinding Command="{Binding KeyCommand}" Key="Enter"></KeyBinding>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="GND nets identifier (a;b;c):" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" VerticalAlignment="Center" Margin="5" Text="{Binding GndIdentifier, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Column="2" Text="Blacklist (a;b;c):" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Column="3" VerticalAlignment="Center" Margin="5" Text="{Binding GndBlacklist, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="1" Text="Power nets identifier (a;b;c):" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="5" Text="{Binding PowerIdentifier, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Column="2" Grid.Row="1" Text="Blacklist (a;b;c):" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Column="3" Grid.Row="1" VerticalAlignment="Center" Margin="5" Text="{Binding PowerBlacklist, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Text="JTAG nets identifier (a;b;c):" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Margin="5" Text="{Binding JTAGIdentifier, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Column="2" Grid.Row="2" Text="Blacklist (a;b;c):" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Column="3" Grid.Row="2" VerticalAlignment="Center" Margin="5" Text="{Binding JTAGBlacklist, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Save" Grid.Column="3" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Width="100" Height="25" Command="{Binding SaveCommand}" />
    </Grid>
</Window>
