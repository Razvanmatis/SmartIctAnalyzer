<UserControl x:Class="Ui.Modules.ModuleName.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="true"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Ui.Modules.ModuleName.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="2">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File">
                    <MenuItem Header="Project file">
                        <MenuItem Header="Open project file" Command="{Binding OpenProjectFileCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="OpenInNew" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Create new project file" Command="{Binding CreateProjectFileCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FileOutline" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save to new project file" Command="{Binding SaveProjectFileCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="ContentSaveAll" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Close project file" IsEnabled="{Binding CloseProjectEnabled}" Command="{Binding CloseProjectFileCommand}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="ExitRun" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Open ODB project folder" Command="{Binding OpenCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="OpenInNew" Width="22" Height="22"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem IsEnabled="{Binding ExportJsonAndBomEnabled}" Header="Import BOM data file" Command="{Binding ImportBomCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="WatchImport" Width="22" Height="22"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Import data from JSON file" Command="{Binding ImportCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="WatchImport" Width="22" Height="22"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem IsEnabled="{Binding ExportJsonAndBomEnabled}" Header="Export data into JSON file" Command="{Binding ExportCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FileExport" Width="22" Height="22"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="ExitRun" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Settings">
                    <MenuItem Header="Show settings" Command="{Binding AllSettingsCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Settings" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Import settings file" Command="{Binding ImportSettingsCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Import" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Export settings file" Command="{Binding ExportSettingsCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Export" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Test coverage">
                    <MenuItem Header="Boundary scan test">
                        <MenuItem Header="Determine all boundary scan objects" Command="{Binding RunTestCoverageForDeterminingObjects}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="{Binding ItemTestCoverageObjects}" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Open chart window" Command="{Binding OpenChartWindow}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="ChartDonut" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Determine test coverage for JTAGs" Command="{Binding RunTestCoverageForIcs}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="{Binding ItemTestCoverageJtag}" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Determine test coverage for all PullUps" Command="{Binding RunTestCoverageForPullUps}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="{Binding ItemTestCoveragePullup}" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Determine test coverage for all PullDowns" Command="{Binding RunTestCoverageForPullDowns}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="{Binding ItemTestCoveragePulldown}" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Determine test coverage for all PullUps and PullDowns" Command="{Binding RunTestCoverageForPullUpsDowns}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="{Binding ItemTestCoveragePullupdown}" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Determine test coverage for all other components" Command="{Binding GetTestCoverageForAllOthers}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="{Binding ItemTestCoverageOthers}" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Determine complete test coverage of boundary scan" Command="{Binding GetCompleteTestCoverageOfJtags}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="{Binding ItemTestCoverageAll}" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Export PIN connection information into file" Command="{Binding GetPinInformationJtags}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FileExport" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding TestCoverageMenuItemsEnabled}" Header="Generate SVF data files" Command="{Binding GenerateSvfFiles}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FileExport" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding ExportPdfEnabled}" Header="Export report into PDF file" Command="{Binding GetPdfFile}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="PdfBox" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem IsEnabled="{Binding ExportPdfEnabled}" Header="Export report into CSV file" Command="{Binding GetCsvFile}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FileCsv" Width="22" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Play SVF">
                    <MenuItem Visibility="Visible" Header="Play SVF file" Command="{Binding PlaySvfFile}" />
                    <MenuItem Visibility="Visible" Header="Play SVF folder" Command="{Binding PlaySvfFolder}" />
                </MenuItem>
            </Menu>
        </DockPanel>
    </Grid>
</UserControl>
