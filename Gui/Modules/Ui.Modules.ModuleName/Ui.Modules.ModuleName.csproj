<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ui.Modules.ModuleName</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <NeutralLanguage>en-150</NeutralLanguage>
	<IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Ressources\start.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="27.2.1" />
    <PackageReference Include="DotNetZip" Version="1.16.0" />
    <PackageReference Include="LiveCharts" Version="0.9.7" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="log4net" Version="2.0.12" />
    <PackageReference Include="MaterialDesignThemes" Version="4.1.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="3.1.0" />
    <PackageReference Include="Prism.Wpf" Version="8.0.0.1909" />
    <PackageReference Include="ProMik.BSDL.Interfaces" Version="1.0.16-beta" />
    <PackageReference Include="ProMik.Core.Interfaces" Version="1.0.71-beta" />
    <PackageReference Include="ProMik.Svf.Contracts" Version="1.0.0" />
    <PackageReference Include="ProMik.SvfPlayer" Version="1.0.20-beta" />
    <PackageReference Include="ProMik.UI.WPF" Version="1.0.69-beta" />
    <PackageReference Include="System.Collections" Version="4.3.0" />
    <PackageReference Include="System.ObjectModel" Version="4.3.0" />
    <PackageReference Include="System.Security.Permissions" Version="5.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\ConsoleApplication\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\..\..\NetStandard\GrpcClientParser\GrpcClientParser.csproj" />
    <ProjectReference Include="..\..\..\NetStandard\ManifestHandling\ManifestHandling.csproj" />
    <ProjectReference Include="..\..\..\NetStandard\PinInformationExtractor\PinInformationExtractor.csproj" />
    <ProjectReference Include="..\..\..\NetStandard\ReportCreator\ReportCreator.csproj" />
    <ProjectReference Include="..\..\..\NetStandard\SVFHelper\SVFHelper.csproj" />
    <ProjectReference Include="..\..\..\SmartIct.Interfaces\Interfaces.csproj" />
    <ProjectReference Include="..\..\..\Tests\TestCoverage\TestCoverage.csproj" />
    <ProjectReference Include="..\..\Ui.Core\Ui.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
    <AdditionalFiles Include="..\..\..\stylecop.json" Link="Properties\stylecop.json" />
    <Resource Include="Ressources\start.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <PackageReference Include="Microsoft.CodeAnalysis.FxCopAnalyzers" Version="3.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="TextRessources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TextRessources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\ChartsViewForExport.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\MenuView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="TextRessources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TextRessources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\ChartsViewForExport.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\MenuView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\PCBLineDataTemplate.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\PCBTestpointDataTemplate.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>